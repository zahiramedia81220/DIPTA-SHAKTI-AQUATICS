  "firestore": {
    "/members/{memberId}": {
      "schema": "Member",
      "description": "Registered club members data"
    },
    "/memberAccounts/{accId}": {
      "schema": "MemberAccount",
      "description": "Member authentication credentials"
    },
    "/scheduleSlots/{slotId}": {
      "schema": "ScheduleSlot",
      "description": "Weekly training schedule slots"
    },
    "/scheduleRequests/{requestId}": {
      "schema": "ScheduleRequest",
      "description": "Training schedule requests by members or applicants"
    },
    "/clubSettings/{settingId}": {
      "schema": "ClubSettings",
      "description": "Club profile, hero, logo, contact, and payment settings"
    },
    "/pricePackages/{packageId}": {
      "schema": "PricePackage",
      "description": "Training packages and pricing tiers"
    },
    "/documentation/{docId}": {
      "schema": "DocumentationItem",
      "description": "Photo documentation of swimming club"
    },
    "/testimonials/{testiId}": {
      "schema": "TestimonialItem",
      "description": "Member and parent testimonials"
    },
    "/swimGear/{gearId}": {
      "schema": "SwimGearProduct",
      "description": "Swimming equipment and merchandise"
    },
    "/memberReports/{reportId}": {
      "schema": "MemberReport",
      "description": "Member assessment and progress report cards"
    },
    "/attendanceRecords/{recordId}": {
      "schema": "AttendanceRecord",
      "description": "Session attendance history"
    },
    "/evaluationCriteria/{critId}": {
      "schema": "EvaluationCriterion",
      "description": "Evaluation rubrics and criteria"
    },
    "/clubInvoices/{invoiceId}": {
      "schema": "ClubInvoice",
      "description": "Club tuition and finance records"
    },
    "/memberAuth/{uid}": {
      "schema": "MemberAuth",
      "description": "Firebase Auth uid -> member mapping (admin writes, owner reads)"
    },
    "/loginLogs/{logId}": {
      "schema": "LoginLog",
      "description": "Login history, append-only, admin read"
    },
    "/presence/{uid}": {
      "schema": "Presence",
      "description": "Online status heartbeat, owner writes, admin reads"
    },
    "/publicStats/{id}": {
      "schema": "PublicStats",
      "description": "Public stats, admin writes"
    }
  }
}